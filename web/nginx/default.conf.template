# Rendered by the nginx image's entrypoint (envsubst) into
# /etc/nginx/conf.d/default.conf. Only ${API_UPSTREAM} is substituted;
# nginx's own $variables are left alone because they aren't set in the env.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Frame-Options "DENY" always;

    # In the cluster the Gateway routes /v1 straight to the API, so requests
    # never reach this block. It exists for docker compose, where nginx is
    # the only entry point.
    location /v1/ {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Request-Id $request_id;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
